package views

import (
	db "proyecto/db/sqlc"
	"strconv"
)

templ GenreForm() {
	<h2>Géneros</h2>
	<form hx-post="/genres" hx-target="#genre-list-container" hx-swap="outerHTML">
		<label>
			Nuevo género
			<input type="text" name="name" required maxlength="255" placeholder="Ej: Drama"/>
		</label>
		<button type="submit">Agregar género</button>
	</form>
}

templ GenreList(genres []db.Genre, msg string) {
	<div id="genre-list-container">
		if msg != "" {
			<p>{ msg }</p>
		}
		if len(genres) == 0 {
			<p>No hay géneros registrados.</p>
		} else {
			<ul>
				for _, genre := range genres {
					<li>
						{ genre.NameGenre }
						<button
							hx-delete={ "/genres/" + strconv.Itoa(int(genre.ID)) }
							hx-target="closest li"
							hx-swap="outerHTML"
							hx-confirm="¿Estás seguro de eliminar este género?">
							Borrar
						</button>
					</li>
				}
			</ul>
		}
	</div>
}

templ GenreOptions(genres []db.Genre) {
	if len(genres) > 0 {
		<fieldset>
			<legend>Géneros</legend>
			for _, genre := range genres {
				<label>
					<input type="checkbox" name="genres" value={ strconv.Itoa(int(genre.ID)) }/>
					{ genre.NameGenre }
				</label>
			}
		</fieldset>
	}
}

templ GenreCheckboxes(genres []db.Genre) {
	<div id="genre-checkboxes">
		@GenreOptions(genres)
	</div>
}

templ GenreCheckboxesOOB(genres []db.Genre) {
	<div id="genre-checkboxes" hx-swap-oob="true">
		@GenreOptions(genres)
	</div>
}